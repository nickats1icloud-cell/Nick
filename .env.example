# Ρύθμιση backend για το Race Control (/championship).
#
# Αντίγραψέ το ως `.env.local` (δεν ανεβαίνει στο git) και συμπλήρωσε τα δικά
# σου. Χωρίς αυτά, η εφαρμογή τρέχει σε τοπική λειτουργία (localStorage).
#
# Τα βρίσκεις στο Supabase Dashboard → Project Settings → API.
# Το anon/publishable key είναι σχεδιασμένο να είναι δημόσιο — την πρόσβαση την
# κρίνει το Row Level Security. ΠΟΤΕ μη βάλεις εδώ το service_role key.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Προαιρετικό: κλείδωσε την εφαρμογή σε ένα συγκεκριμένο πρωτάθλημα.
# Αν μείνει κενό, φορτώνεται αυτόματα αυτό στο οποίο συμμετέχεις.
# VITE_LMU_CHAMPIONSHIP_ID=
